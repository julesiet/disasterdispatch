# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/disasteralert

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── NASA FIRMS ────────────────────────────────────────────────────────────────
# Free API key: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=your_firms_api_key_here

# Bounding box to monitor for active fires: minLon,minLat,maxLon,maxLat
# Example below covers greater Los Angeles area
FIRMS_BOUNDING_BOX=-119.0,33.5,-116.5,34.8

# Fire Radiative Power threshold above which a zone is classified as imminent
FIRMS_IMMINENT_FRP_THRESHOLD=50

# ── Alert Radii ───────────────────────────────────────────────────────────────
# Distance in metres from zone edge that triggers an "approaching" alert
APPROACHING_RADIUS_M=10000

# Distance in metres from zone edge that triggers an "imminent" alert
IMMINENT_RADIUS_M=2000

# ── Heatmap ───────────────────────────────────────────────────────────────────
# Grid cell size in decimal degrees (~0.01 ≈ 1km at mid-latitudes)
HEATMAP_GRID_DEGREES=0.01

# ── Admin ─────────────────────────────────────────────────────────────────────
# Arbitrary secret key — include as x-api-key header on admin requests
ADMIN_API_KEY=change_me_before_use
